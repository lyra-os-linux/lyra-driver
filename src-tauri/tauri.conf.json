{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lyra Driver",
  "version": "0.1.0",
  "identifier": "org.lyraos.LyraDriver",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "enableGTKAppId": true,
    "windows": [
      {
        "title": "Drivers",
        "width": 1060,
        "height": 720,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "label": "main",
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "shortDescription": "Drivers de terceiros",
    "icon": [
      "icons/icon.png"
    ]
  }
}
